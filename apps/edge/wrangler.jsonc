{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "buildpair-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "SPACE_ROOM", "class_name": "SpaceRoom" },
      { "name": "USER_HUB", "class_name": "UserHub" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SpaceRoom", "UserHub"] }],
  "ratelimits": [
    // Sign-in, sign-up and email codes: per network address.
    { "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    // Changes (commands, invites, moves, new spaces): per signed-in person.
    { "name": "WRITE_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "buildpair-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Secrets (BETTER_AUTH_SECRET, TICKET_SECRET, RESEND_API_KEY, GOOGLE_CLIENT_SECRET) come from
  // .dev.vars locally and the GitHub environment (the deploy workflow copies them) in deployed environments.
  "vars": {
    "ENVIRONMENT": "development",
    "APP_ORIGINS": "http://localhost:8081,http://localhost:8788,http://localhost:19006",
    "BETTER_AUTH_URL": "http://localhost:8787",
    "EMAIL_PROVIDER": "console",
    "EMAIL_FROM": "Buildpair <hello@buildpair.app>",
    // A shared test account (sign in with the bare name). Staging and previews too; production refuses it.
    "TEST_LOGIN": "bagel:bagel"
  },
  "env": {
    "staging": {
      "name": "buildpair-api-staging",
      "routes": [{ "pattern": "api-staging.buildpair.app", "custom_domain": true }],
      "durable_objects": {
        "bindings": [
          { "name": "SPACE_ROOM", "class_name": "SpaceRoom" },
          { "name": "USER_HUB", "class_name": "UserHub" }
        ]
      },
      "ratelimits": [
        // Sign-in, sign-up and email codes: per network address.
        { "name": "AUTH_LIMIT", "namespace_id": "1101", "simple": { "limit": 20, "period": 60 } },
        // Changes (commands, invites, moves, new spaces): per signed-in person.
        { "name": "WRITE_LIMIT", "namespace_id": "1102", "simple": { "limit": 120, "period": 60 } }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "buildpair-staging",
          "database_id": "9f47a350-976e-4791-aa47-100f3b7b1262",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_ORIGINS": "https://app-staging.buildpair.app,https://staging.buildpair.app",
        "BETTER_AUTH_URL": "https://api-staging.buildpair.app",
        "EMAIL_PROVIDER": "resend",
        "EMAIL_FROM": "Buildpair <hello@buildpair.app>",
        "TEST_LOGIN": "bagel:bagel"
      }
    },
    "production": {
      "name": "buildpair-api-production",
      "routes": [{ "pattern": "api.buildpair.app", "custom_domain": true }],
      "durable_objects": {
        "bindings": [
          { "name": "SPACE_ROOM", "class_name": "SpaceRoom" },
          { "name": "USER_HUB", "class_name": "UserHub" }
        ]
      },
      "ratelimits": [
        // Sign-in, sign-up and email codes: per network address.
        { "name": "AUTH_LIMIT", "namespace_id": "1201", "simple": { "limit": 20, "period": 60 } },
        // Changes (commands, invites, moves, new spaces): per signed-in person.
        { "name": "WRITE_LIMIT", "namespace_id": "1202", "simple": { "limit": 120, "period": 60 } }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "buildpair-production",
          "database_id": "cecac9bf-7941-4da9-b68d-9d0b715d05a8",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "APP_ORIGINS": "https://app.buildpair.app,https://buildpair.app",
        "BETTER_AUTH_URL": "https://api.buildpair.app",
        "EMAIL_PROVIDER": "resend",
        "EMAIL_FROM": "Buildpair <hello@buildpair.app>"
      }
    }
  }
}
