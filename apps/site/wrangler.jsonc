{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "buildpair-site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/config.js", "/join/*", "/app", "/sign-in", "/", "/privacy"]
  },
  "vars": {
    "API_URL": "http://localhost:8787",
    "APP_URL": "http://localhost:8081",
    "GOOGLE_ENABLED": "false"
  },
  "env": {
    "staging": {
      "name": "buildpair-site-staging",
      "routes": [{ "pattern": "staging.buildpair.app", "custom_domain": true }],
      "vars": {
        "API_URL": "https://api-staging.buildpair.app",
        "APP_URL": "https://app-staging.buildpair.app",
        "GOOGLE_ENABLED": "false"
      }
    },
    "production": {
      "name": "buildpair-site-production",
      "routes": [{ "pattern": "buildpair.app", "custom_domain": true }],
      "vars": {
        "API_URL": "https://api.buildpair.app",
        "APP_URL": "https://app.buildpair.app",
        "GOOGLE_ENABLED": "false"
      }
    }
  }
}
