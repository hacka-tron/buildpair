{
  // The web app is static files served from Cloudflare; unknown paths fall back to index.html.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "buildpair-web",
  "compatibility_date": "2026-09-25",
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" },
  "env": {
    "staging": {
      "name": "buildpair-web-staging",
      "routes": [{ "pattern": "staging.buildpair.app", "custom_domain": true }]
    },
    "production": {
      "name": "buildpair-web-production",
      "routes": [{ "pattern": "buildpair.app", "custom_domain": true }]
    }
  }
}
